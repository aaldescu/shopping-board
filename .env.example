# Shopping Board environment variables.
#
# In Dokploy, set these in the service's *Environment* tab and redeploy.
# For local `docker compose up`, copy this file to `.env` (which is
# gitignored) and fill it in. Never commit real keys.
#
# Only DOMAIN is required; everything else is optional and can stay empty.

# ---------- Required ----------

# Public hostname Traefik serves the app on (DNS A-record → your server).
DOMAIN=board.example.com

# ---------- Admin setup page (/setup) ----------
# Set to a long random string (min 16 chars) to unlock https://<DOMAIN>/setup,
# where you create the PocketBase admin or reset its password. Leave empty
# the rest of the time: empty = /setup disabled.
# Generate one with:  openssl rand -hex 24

SETUP_TOKEN=

# ---------- Optional: AI fallback for product pages ----------
# Used when a shop's page can't be read directly. Empty = disabled.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- Optional: Jina Reader fallback ----------
# Renders JavaScript-heavy pages. Set a key for the authenticated endpoint,
# or JINA_ENABLED=true to use the keyless (rate-limited) one.

JINA_API_KEY=
JINA_ENABLED=

# ---------- Optional: automatic backups ----------
# Applied on every boot by pb/pb_hooks/backup.pb.js (see README → Backups).

# Cron schedule, e.g. "0 3 * * *" for nightly at 03:00. Empty = no schedule.
BACKUP_CRON=
# How many automatic backups to keep.
BACKUP_MAX_KEEP=7

# Upload backups to S3-compatible storage (Cloudflare R2, Backblaze B2, …)
# instead of the server's disk.
BACKUP_S3_ENABLED=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET=
# "true" for MinIO and some other S3-compatible providers.
BACKUP_S3_PATH_STYLE=
